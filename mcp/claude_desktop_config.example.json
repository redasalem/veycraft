{
  "mcpServers": {
    "veycraft": {
      "command": "npx",
      "args": [
        "-y",
        "veycraft",
        "mcp"
      ],
      "env": {
        "NPM_CONFIG_UPDATE_NOTIFIER": "false",
        "NPM_CONFIG_FUND": "false",
        "NPM_CONFIG_AUDIT": "false",
        "NPM_CONFIG_LOGLEVEL": "error"
      }
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.86",
        "--caps=pdf",
        "--user-data-dir=/ABS/PATH/TO/veycraft/browser-profile"
      ],
      "env": {
        "NPM_CONFIG_UPDATE_NOTIFIER": "false",
        "NPM_CONFIG_FUND": "false",
        "NPM_CONFIG_AUDIT": "false",
        "NPM_CONFIG_LOGLEVEL": "error"
      }
    },
    "notion": {
      "command": "npx",
      "args": [
        "-y",
        "@notionhq/notion-mcp-server@2.6.1"
      ],
      "env": {
        "NOTION_TOKEN": "REPLACE_WITH_YOUR_NOTION_TOKEN",
        "NPM_CONFIG_UPDATE_NOTIFIER": "false",
        "NPM_CONFIG_FUND": "false",
        "NPM_CONFIG_AUDIT": "false",
        "NPM_CONFIG_LOGLEVEL": "error"
      }
    }
  }
}
