# Example facts below are NOT verified owner answers. Review every fact before setting true.
owner_verified: false
resume_pdf_path: "./assets/resume.pdf"
questions:
  - match: ["years of experience", "how many years"]
    answer: "5"
  - match: ["notice period", "start date", "when can you start"]
    answer: "30 days"
  - match: ["require sponsorship", "visa sponsorship"]
    answer: "Yes"
  - match: ["authorized to work in egypt"]
    answer: "Yes"
  - match: ["expected salary", "salary expectation"]
    answer: "Open to discuss; target range 3,000–4,000 USD/month"
  - match: ["willing to relocate"]
    answer: "Yes"
  - match: ["english proficiency"]
    answer: "Professional working proficiency"
  - match: ["school", "university", "institution"]
    answer: "REPLACE_WITH_YOUR_UNIVERSITY_NAME"
  - match: ["timezone", "time zone", "overlap"]
    answer: "EET (UTC+2); available for 4+ hours daily overlap with UTC+3 / CET"
skills_years:
  React: 5
  TypeScript: 4
  Node.js: 3
  GraphQL: 2
  Next.js: 3
eeo:
  gender: "Decline to self-identify"
  ethnicity: "Decline to self-identify"
  veteran: "I am not a protected veteran"
  disability: "I do not wish to answer"
eeo_and_compliance_defaults:
  gender: "Decline to self-identify"
  ethnicity: "Decline to self-identify"
  veteran_status: "Decline to self-identify"
  disability_status: "Prefer not to say"
  referral_source: "LinkedIn"
  gdpr_privacy_consent: true
winning_answers:
  ai_workflow: "REPLACE_WITH_YOUR_VERIFIED_AI_TOOLS_AND_REVIEW_WORKFLOW"
  hardest_project: "REPLACE_WITH_YOUR_STRONGEST_SHIPPED_PROJECT_AND_METRIC"
  why_remote: "REPLACE_WITH_YOUR_ASYNC_REMOTE_COLLABORATION_TRACK_RECORD"
  availability: "REPLACE_WITH_YOUR_NOTICE_PERIOD_AND_START_FLEXIBILITY"
