{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/redasalem/veycraft/schemas/career-insights.schema.json",
  "title": "Veycraft Career Insights & Daily Run Artifacts",
  "description": "Validates logs/insights/<type>-<period>.json and logs/runs/YYYY-MM-DD.json while preserving backward compatibility and separating deterministic metrics from AI interpretations.",
  "oneOf": [
    { "$ref": "#/$defs/insight_report" },
    { "$ref": "#/$defs/daily_run" }
  ],
  "$defs": {
    "skill_count": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill", "count"],
      "properties": {
        "skill": { "type": "string", "minLength": 1 },
        "count": { "type": "integer", "minimum": 0 }
      }
    },
    "ai_statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "evidence_refs"],
      "properties": {
        "claim": { "type": "string", "minLength": 1 },
        "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "confidence": { "enum": ["low", "medium", "high"] }
      }
    },
    "insight_report": {
      "type": "object",
      "required": ["type", "period", "generated_at", "scanned", "applied"],
      "properties": {
        "schema_version": { "const": "2.0" },
        "type": { "enum": ["weekly", "monthly", "calibration", "rejection_audit", "all"] },
        "period": { "type": "string", "minLength": 1 },
        "generated_at": { "type": "string", "format": "date-time" },
        "scanned": { "type": "integer", "minimum": 0 },
        "prepared": { "type": "integer", "minimum": 0 },
        "applied": { "type": "integer", "minimum": 0 },
        "match_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "avg_match_score": { "type": ["number", "null"], "minimum": 0, "maximum": 10 },
        "top_skills": { "type": "array", "items": { "$ref": "#/$defs/skill_count" } },
        "skill_gaps": { "type": "array", "items": { "$ref": "#/$defs/skill_count" } },
        "recommendations": { "type": "array", "items": { "type": "string" } },
        "notion_synced": { "type": "boolean" },
        "intelligence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["deterministic_facts", "sample_sufficiency"],
          "properties": {
            "deterministic_facts": { "type": "object" },
            "sample_sufficiency": {
              "type": "object",
              "additionalProperties": false,
              "required": ["submitted_n", "decided_n", "min_threshold", "sufficient"],
              "properties": {
                "submitted_n": { "type": "integer", "minimum": 0 },
                "decided_n": { "type": "integer", "minimum": 0 },
                "min_threshold": { "type": "integer", "minimum": 1 },
                "sufficient": { "type": "boolean" }
              }
            },
            "ai_interpretations": { "type": "array", "items": { "$ref": "#/$defs/ai_statement" } },
            "hypotheses": { "type": "array", "items": { "$ref": "#/$defs/ai_statement" } },
            "recommended_actions": { "type": "array", "items": { "$ref": "#/$defs/ai_statement" } }
          }
        }
      }
    },
    "daily_run": {
      "type": "object",
      "required": ["run_id", "started_at", "dry_run", "status", "counts"],
      "properties": {
        "run_id": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "started_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": ["string", "null"], "format": "date-time" },
        "dry_run": { "type": "boolean" },
        "status": { "enum": ["running", "completed", "aborted"] },
        "counts": {
          "type": "object",
          "required": ["scanned", "applied", "dry_run", "needs_review", "skipped", "failed"],
          "properties": {
            "scanned": { "type": "integer", "minimum": 0 },
            "prepared": { "type": "integer", "minimum": 0 },
            "applied": { "type": "integer", "minimum": 0 },
            "dry_run": { "type": "integer", "minimum": 0 },
            "needs_review": { "type": "integer", "minimum": 0 },
            "skipped": { "type": "integer", "minimum": 0 },
            "failed": { "type": "integer", "minimum": 0 }
          }
        },
        "platforms": { "type": "array", "items": { "type": "string" } },
        "errors": { "type": "array", "items": { "type": "string" } },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["at", "step"],
            "properties": {
              "at": { "type": "string", "format": "date-time" },
              "step": { "type": "string", "minLength": 1 },
              "detail": { "type": "string" }
            }
          }
        },
        "notes": { "type": "string" }
      }
    }
  }
}
